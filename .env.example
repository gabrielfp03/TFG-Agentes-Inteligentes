# ============================================================
#  PLANTILLA DE CREDENCIALES - Proyecto "Paquita"
# ============================================================

# ----- Modelo de lenguaje (Google Gemini) -----
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# ----- Correo (Gmail vía IMAP) -----
# Usa una "contraseña de aplicación" de Google, NO tu contraseña normal.
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_SERVER=imap.gmail.com

# ----- Telegram (bot de difusión) -----
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=@nombre_de_tu_canal_o_id

# ----- Mastodon (operativa bidireccional) -----
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=tu_token_de_acceso_de_mastodon

# ----- Google Apps Script (pasarela / API Gateway) -----
# URLs de despliegue de tus scripts (terminan en /exec).
APPSCRIPT_WEBHOOK_CITAS=https://script.google.com/macros/s/XXXXXXXX/exec
APPSCRIPT_WEBHOOK_TAREAS=https://script.google.com/macros/s/XXXXXXXX/exec

# ----- Bases de datos locales (rutas dentro del contenedor) -----
DB_CLIENTES=/app/langflow/bd/crm_pyme.db
DB_INVENTARIO=/app/langflow/bd/inventario_pyme.db

# ----- System Prompt externo -----
PROMPT_PATH=/app/langflow/prompt/prompt_paquita.md

# ----- Exposición de puertos (desarrollo) -----
NGROK_AUTHTOKEN=tu_token_de_ngrok
LANGFLOW_PORT=7860
